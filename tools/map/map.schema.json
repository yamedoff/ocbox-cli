{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "map.json",
  "description": "Architecture map for one repo. Spec: MAP_SPEC.md. Validate with: node tools/map/cli.mjs check",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "buildings"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "repo": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$", "description": "The repo's short name (\"my-api\"), not owner/name." },
    "visibility": { "enum": ["public", "private"] },
    "openapi": { "type": "string", "description": "Repo-relative path to the OpenAPI file whose operationIds connections may use." },
    "buildings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "was": { "$ref": "#/$defs/id", "description": "Previous id, when renaming (keeps the Notion row and its notes)." },
        "name": { "type": "string", "maxLength": 60 },
        "kind": { "enum": ["app", "cdn", "gateway", "service", "worker", "queue", "cache", "database", "storage", "outside"] },
        "zone": { "enum": ["public", "private", "outside"] }, "status": { "$ref": "#/$defs/status" }, "path": { "type": "string" },
        "summary": { "type": "string", "maxLength": 300 },
        "serves": { "type": "array", "items": { "$ref": "#/$defs/op" }, "description": "Operations this building answers (put them on the implementer, not the gateway)." },
        "via": { "$ref": "#/$defs/id", "description": "The gateway every call to this building passes through." },
        "areas": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "summary"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "maxLength": 60 }, "summary": { "type": "string", "maxLength": 300 }, "path": { "type": "string" } } } } } } },
    "connections": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to", "kind"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "type": "string" }, "to": { "type": "string" },
        "kind": { "enum": ["request", "queue", "database", "event", "email"] }, "label": { "type": "string", "maxLength": 80 }, "status": { "$ref": "#/$defs/status" },
        "via": { "$ref": "#/$defs/id", "description": "A gateway this call passes through on its way." } } } },
    "code": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "building", "name", "path", "summary"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "was": { "$ref": "#/$defs/id" }, "building": { "type": "string" }, "area": { "type": "string", "description": "An area id of the building." },
        "name": { "type": "string", "maxLength": 60 },
        "kind": { "enum": ["file", "function", "class", "route", "job", "config"] }, "path": { "type": "string" },
        "lines": { "type": "string", "pattern": "^\\d+(-\\d+)?$" }, "symbol": { "type": "string", "description": "The name this entry defines: fn, Class, Class.method or Class.#private. check keeps lines in step with it." },
        "summary": { "type": "string", "maxLength": 300 },
        "calls": { "type": "array", "items": { "type": "string" } }, "snippet": { "type": "string" } } } },
    "journeys": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "steps"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "was": { "$ref": "#/$defs/id" }, "name": { "type": "string", "maxLength": 60 }, "summary": { "type": "string", "maxLength": 300 },
        "status": { "$ref": "#/$defs/status" }, "trigger": { "$ref": "#/$defs/op" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } } } } },
    "guides": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "path", "about"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "maxLength": 100 }, "path": { "type": "string", "pattern": "\\.md$" },
        "about": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "journeys": { "type": "array", "items": { "type": "string" } } } } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "status": { "enum": ["live", "planned", "deprecated"] },
    "op": { "type": "string", "pattern": "^openapi:[A-Za-z0-9_.-]+$" },
    "codeRef": { "oneOf": [{ "type": "string" }, { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string" } }] },
    "step": { "type": "object", "additionalProperties": false, "required": ["story"],
      "properties": { "story": { "type": "string", "maxLength": 300 }, "building": { "type": "string" }, "connection": { "type": "string" }, "code": { "$ref": "#/$defs/codeRef" },
        "repeat": { "type": "boolean", "description": "This step loops (a poll, a retry, one stage per pass)." },
        "on_failure": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["story"],
          "properties": { "story": { "type": "string", "maxLength": 300 }, "building": { "type": "string" }, "connection": { "type": "string" }, "code": { "$ref": "#/$defs/codeRef" }, "repeat": { "type": "boolean" } } } } } }
  }
}
