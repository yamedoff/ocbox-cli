{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "map.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "buildings"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "repo": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "visibility": { "enum": ["public", "private"] },
    "openapi": { "type": "string" },
    "buildings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "summary"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "maxLength": 60 },
        "kind": { "enum": ["app", "cdn", "gateway", "service", "worker", "queue", "cache", "database", "storage", "outside"] },
        "zone": { "enum": ["public", "private", "outside"] }, "status": { "$ref": "#/$defs/status" }, "path": { "type": "string" },
        "summary": { "type": "string", "maxLength": 300 }, "serves": { "type": "array", "items": { "$ref": "#/$defs/op" } } } } },
    "connections": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to", "kind"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "type": "string" }, "to": { "type": "string" },
        "kind": { "enum": ["request", "queue", "database", "event", "email"] }, "label": { "type": "string", "maxLength": 80 }, "status": { "$ref": "#/$defs/status" } } } },
    "code": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "building", "name", "path", "summary"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "building": { "type": "string" }, "name": { "type": "string", "maxLength": 60 },
        "kind": { "enum": ["file", "function", "class", "route", "job", "config"] }, "path": { "type": "string" },
        "lines": { "type": "string", "pattern": "^\\d+(-\\d+)?$" }, "symbol": { "type": "string" }, "summary": { "type": "string", "maxLength": 300 },
        "calls": { "type": "array", "items": { "type": "string" } }, "snippet": { "type": "string" } } } },
    "journeys": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "steps"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "maxLength": 60 }, "summary": { "type": "string", "maxLength": 300 },
        "status": { "$ref": "#/$defs/status" }, "trigger": { "$ref": "#/$defs/op" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["story"],
          "properties": { "story": { "type": "string", "maxLength": 300 }, "building": { "type": "string" }, "connection": { "type": "string" }, "code": { "type": "string" } } } } } } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "status": { "enum": ["live", "planned", "deprecated"] },
    "op": { "type": "string", "pattern": "^openapi:[A-Za-z0-9_.-]+$" }
  }
}
